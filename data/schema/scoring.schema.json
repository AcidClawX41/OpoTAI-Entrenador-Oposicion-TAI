{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opotai/scoring.schema.json",
  "title": "OpoTAI · Esquemas de puntuación (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_scheme", "schemes"],
  "properties": {
    "schema_version": { "const": 1 },
    "default_scheme": { "type": "string" },
    "schemes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scheme" } }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": { "title": { "type": "string" }, "url": { "type": "string" } }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "title", "kind", "questions", "value"],
      "properties": {
        "part": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "kind": { "enum": ["theory", "case"] },
        "questions": { "type": "integer", "minimum": 1 },
        "reserve": { "type": "integer", "minimum": 0 },
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "penalty_divisor": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "cases_offered": { "type": ["integer", "null"], "minimum": 1 },
        "cases_to_choose": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "max_grade", "pass_grade", "min_direct_ratio"],
      "properties": {
        "parts": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "max_grade": { "type": "number", "exclusiveMinimum": 0 },
        "pass_grade": { "type": "number", "minimum": 0 },
        "min_direct_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "cutoff_direct": { "type": ["number", "null"] },
        "cutoff_note": { "type": ["string", "null"] }
      }
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "access", "duration_minutes", "parts", "grading"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "access": { "enum": ["libre", "promocion_interna"] },
        "convocatoria": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "duration_minutes": { "type": "integer", "minimum": 1 },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "grading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["units"],
          "properties": { "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } } }
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opotai/teoria.schema.json",
  "title": "OpoTAI · Índice de teoría (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "topics"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "file", "title", "summary", "reading_minutes", "key_points", "sources"],
        "properties": {
          "topic": { "type": "string", "pattern": "^(I|II|III|IV)\\.[0-9]{1,2}$" },
          "file": { "type": "string", "pattern": "^(I|II|III|IV)\\.[0-9]{1,2}\\.md$" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "reading_minutes": { "type": "integer", "minimum": 1 },
          "key_points": { "type": "array", "items": { "type": "string" } },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url"],
              "properties": { "title": { "type": "string" }, "url": { "type": "string" } }
            }
          },
          "updated": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpoTAI",
  "version": "1.0.0",
  "identifier": "com.ericvallsgramunt.opotai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpoTAI · Entrenador de oposiciones TAI",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Eric Valls Gramunt",
    "copyright": "© 2026 Eric Valls Gramunt · GPL-3.0-or-later",
    "category": "Education",
    "shortDescription": "Tests y simulacros de la oposición TAI (AGE)",
    "longDescription": "OpoTAI es un entrenador de escritorio para la oposición de Técnicos Auxiliares de Informática de la Administración del Estado: exámenes oficiales de convocatorias anteriores, simulacros con la puntuación y penalización reales, explicaciones de cada fallo, estadísticas y estimación de la probabilidad de obtener plaza.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "education",
        "recommends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      },
      "rpm": {
        "recommends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
